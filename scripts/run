#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"

usage() {
    cat >&2 <<'USAGE'
Usage: ./scripts/run [--target TARGET] [options...]

TARGET is native (the default), web or android. The web target builds the
bundle and hosts it, and the android target installs the APK on the attached
device and launches it.

Native options:  [--release] [-- APPLICATION ARGUMENTS...]
Web options:     [--release]
Android options: [--android-sdk DIRECTORY] [--application-id ID] [--label LABEL]
USAGE
}

target='native'
arguments=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --target)
            target="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            arguments+=("$1")
            shift
            ;;
    esac
done

case "$target" in
    native)
        exec "$internal/run-native.sh" "${arguments[@]}"
        ;;
    web)
        exec "$internal/run-web.sh" "${arguments[@]}"
        ;;
    android)
        exec "$internal/run-android.sh" "${arguments[@]}"
        ;;
    *)
        echo "Unknown target: $target" >&2
        usage
        exit 1
        ;;
esac
