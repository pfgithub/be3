#!/usr/bin/env bash
#
# Strips comments, lints, formats and tests the workspace.
#
# Runs the Rust comment stripper, clippy, rustfmt and the test suite over the
# whole workspace. This is the one command to run after making changes.
#
# By default comments are stripped, clippy applies the fixes it can and rustfmt
# rewrites the sources. With --check nothing is written and each tool only
# reports, which is what CI wants. Either way the run fails if comments or any
# clippy warning survive.
#
# Usage:
#   ./scripts/verify
#   ./scripts/verify --check

set -euo pipefail

check=false
if [[ "${1:-}" == "--check" ]]; then
    check=true
fi

repository="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository"

echo 'Stripping Rust comments...'
strip_arguments=()
if $check; then
    strip_arguments+=(--check)
fi
cargo run --quiet -p strip-rust-comments -- "${strip_arguments[@]}"

# Tests and examples are linted too, so a warning cannot hide in them.
clippy_targets=(--workspace --all-targets --all-features)

if $check; then
    echo 'Checking for clippy warnings...'
    cargo clippy "${clippy_targets[@]}" -- -D warnings
else
    echo 'Applying clippy fixes...'
    # The tree is expected to be mid-change; fixing only a pristine checkout
    # would make the script useless during development.
    cargo clippy --fix --allow-dirty --allow-staged "${clippy_targets[@]}" -- -D warnings
fi

echo 'Formatting...'
format_arguments=(--all)
if $check; then
    format_arguments+=(--check)
fi
cargo fmt "${format_arguments[@]}"

echo 'Running tests...'
test_arguments=(--workspace)
if $check; then
    test_arguments+=(--profile ci)
fi
cargo nextest run "${test_arguments[@]}"

echo ''
echo 'All checks passed.'
