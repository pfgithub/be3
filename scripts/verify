#!/usr/bin/env bash
#
# Fixes Rust source layout, strips comments, lints, formats and tests.
#
# Runs the Rust source fixer, clippy, rustfmt and the test suite over the whole
# workspace. This is the one command to run after making changes.
#
# By default source layout and comments are fixed, clippy applies the fixes it
# can, rustfmt rewrites the sources and the tests accept whatever painting they
# produce. With --check nothing is written and each tool only reports, which is
# what CI wants. Either way the run fails if a Rust source violation or clippy
# warning survives.
#
# Usage:
#   ./scripts/verify
#   ./scripts/verify --check

set -uo pipefail

check=false
if [[ "${1:-}" == "--check" ]]; then
    check=true
fi

repository="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository"

failed=false

# block-app links libghostty-vt, the terminal emulator behind the debug
# terminal window. It is Zig rather than Rust, so nothing cargo does builds it,
# and clippy and the tests cannot link the app without it.
echo 'libghostty-vt...'
host_triple="$(rustc --version --verbose | sed -n 's/^host: //p')"
if ! "$repository/scripts/internal/build-ghostty-vt.sh" --triple "$host_triple" > /dev/null; then
    echo 'Verification failed.'
    exit 1
fi

t() {
    if which time >/dev/null 2>&1; then
        if ! TIME="Took %E" time "$@"; then
            failed=true
        fi
    else
        # git bash only has the builtin, no executable
        if ! time "$@"; then
            failed=true
        fi
    fi
}

echo 'cargo fmt...'
if $check; then
    t cargo fmt --all --check
else
    t cargo fmt --all
fi

echo 'crates/fix-rust-source...'
if $check; then
    t cargo run -p fix-rust-source -- --check
else
    t cargo run --quiet -p fix-rust-source
fi

# Tests and examples are linted too, so a warning cannot hide in them.
clippy_targets=(--workspace --all-targets --all-features)

echo 'cargo clippy...'
if $check; then
    t cargo clippy "${clippy_targets[@]}" -- -D warnings
else
    # The tree is expected to be mid-change; fixing only a pristine checkout
    # would make the script useless during development.
    t cargo clippy --quiet --fix --allow-dirty --allow-staged "${clippy_targets[@]}" -- -D warnings
    # cargo clippy --fix caps lints while applying suggestions, so run clippy
    # again to make any warnings that remain fail verification.
    t cargo clippy --quiet "${clippy_targets[@]}" -- -D warnings
fi

echo 'cargo nextest run...'
if $check; then
    t cargo nextest run --profile ci
else
    # A changed painting is not a failure to fix here: the accepted files are
    # rewritten, and it is the diff a person reviews.
    t env UPDATE_SNAPSHOTS=1 cargo nextest run --cargo-quiet --show-progress=none
fi

# in case one of the previous commands leaves stuff unformatted
echo 'format one more time...'
if $check; then
    t cargo fmt --all --check
else
    t cargo fmt --all
fi

echo ''
if $failed; then
    echo 'Verification failed.'
    exit 1
fi

echo 'All checks passed.'
